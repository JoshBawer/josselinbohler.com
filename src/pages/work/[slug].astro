---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyView from '../../components/CaseStudyView.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => data.locale === 'en');
  return entries.map(project => ({ params: { slug: project.data.slug }, props: { project } }));
}
const { project } = Astro.props;
const frEntry = (await getCollection('projects', ({ data }) => data.locale === 'fr' && data.order === project.data.order))[0];
---
<BaseLayout locale="en" title={project.data.title} description={project.data.summary} englishPath={`/work/${project.data.slug}`} frenchPath={`/fr/projets/${frEntry.data.slug}`} image={project.data.cover} imageAlt={project.data.coverAlt}>
  <CaseStudyView project={project} locale="en" />
</BaseLayout>

